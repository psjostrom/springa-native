  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/react": "~19.2.2",
    "babel-plugin-react-compiler": "^19.1.0-beta-20241029",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.1",
    "eslint-plugin-react-compiler": "^19.1.0-beta-20241029",
    "msw": "^2.15.0",
    "tsx": "^4.23.9",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10",
    "vitest-native": "^0.9.0"
  },
  "scripts": {
    "setup:worktree": "node ./scripts/ensure-worktree-setup.mjs",
    "start": "npm run setup:worktree -- development && expo start",
    "start:clear": "npm run setup:worktree -- development && expo start --clear",
    "android": "npm run setup:worktree -- development && expo run:android",
    "android:device": "npm run setup:worktree -- development && expo run:android --device",
    "android:release": "npm run setup:worktree -- production && expo run:android --variant release --device --no-bundler",
    "ios": "npm run setup:worktree -- development && expo run:ios",
    "ios:device": "npm run setup:worktree -- development && expo run:ios --device",
    "ios:release": "npm run setup:worktree -- production && expo run:ios --configuration Release --device",
    "web": "npm run setup:worktree -- development && expo start --web",
    "adb:reverse": "adb reverse tcp:8081 tcp:8081 && adb reverse tcp:3000 tcp:3000",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "reset-project": "node ./scripts/reset-project.js"
  },
  "private": true
}
